<atlassian-plugin key="${atlassian.plugin.key}" name="${project.name}" plugins-version="2">
    <plugin-info>
        <description>${project.description}</description>
        <version>${project.version}</version>
        <vendor name="${project.organization.name}" url="${project.organization.url}" />
        <param name="plugin-icon">images/pluginIcon.png</param>
        <param name="plugin-logo">images/pluginLogo.png</param>
    </plugin-info>

    <!-- add our i18n resource -->
    <resource type="i18n" name="i18n" location="elastic-search" />

    <!-- Multi-SPA Web Resources -->


    <!-- Legacy Resources (for backward compatibility) -->
    <web-resource key="elastic-search-resources" name="elastic-search Legacy Resources">
        <dependency>com.atlassian.auiplugin:ajs</dependency>
        <dependency>elastic-search:user-app-resources</dependency>
        <resource type="download" name="elastic-search.css" location="/css/elastic-search.css" />
        <resource type="download" name="elastic-search.js" location="/js/elastic-search.js" />
        <resource type="download" name="images/" location="/images" />
        <context>elastic-search</context>
    </web-resource>


    <rest key="my-rest-api" path="/myplugin" version="1.0">
        <description>Provides JSON data</description>
        <package>com.atsoft.confluence.plugin.elasticsearch.rest</package>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
    </rest>

    <!-- Multi-SPA Servlets -->

    <!-- User App Servlet -->
    <servlet key="user-app-servlet" name="User App Servlet"
        class="com.atsoft.confluence.plugin.elasticsearch.servlet.UserAppServlet">
        <url-pattern>/user-app/*</url-pattern>
    </servlet>

    <!-- Admin App Servlet -->
    <servlet key="admin-app-servlet" name="Admin App Servlet"
        class="com.atsoft.confluence.plugin.elasticsearch.servlet.AdminAppServlet">
        <url-pattern>/admin-app/*</url-pattern>
    </servlet>

    <!-- Demo App Servlet -->
    <servlet key="demo-app-servlet" name="Demo App Servlet"
        class="com.atsoft.confluence.plugin.elasticsearch.servlet.DemoAppServlet">
        <url-pattern>/demo-app/*</url-pattern>
    </servlet>


    <!-- Multi-SPA Web Items -->

    <!-- User App Access -->
    <web-item key="user-search-link" section="system.header/left" weight="40">
        <label>Elastic Search</label>
        <link>/plugins/servlet/user-app/</link>
        <styleClass>aui-button</styleClass>
    </web-item>

    <!-- Admin App Access -->
    <web-item key="admin-config-link" section="system.admin/config" weight="100">
        <label>Elastic Search Config</label>
        <link>/plugins/servlet/admin-app/</link>
        <styleClass>aui-button</styleClass>
    </web-item>

    <!-- Demo App Access -->
    <web-item key="demo-app-link" section="system.header/left" weight="39">
        <label>Demo App</label>
        <link>/plugins/servlet/demo-app/</link>
        <styleClass>aui-button</styleClass>
    </web-item>

</atlassian-plugin>