<!DOCTYPE html>
<html>
<head>
    <title>$dialogTitle</title>
    <meta name="decorator" content="atl.general">
</head>
<body>
    <div class="aui-page-panel">
        <div class="aui-page-panel-inner">
            <section class="aui-page-panel-content">
                <h1>$dialogTitle</h1>
                
                <div class="aui-message aui-message-info">
                    <p class="title">
                        <strong>정보</strong>
                    </p>
                    <p>$message</p>
                </div>

                <section id="my-dialog" class="aui-dialog2 aui-dialog2-medium" aria-hidden="true" role="dialog">
                    <header class="aui-dialog2-header">
                        <h2 class="aui-dialog2-header-main">$dialogTitle</h2>
                        <a class="aui-dialog2-header-close">
                            <span class="aui-icon aui-icon-small aui-iconfont-close-dialog">Close</span>
                        </a>
                    </header>
                    
                    <div class="aui-dialog2-content">
                        <p>$message</p>
                        <p>현재 사용자: $action.remoteUser.name</p>
                    </div>
                    
                    <footer class="aui-dialog2-footer">
                        <div class="aui-dialog2-footer-actions">
                            <button id="dialog-close-button" class="aui-button aui-button-link">닫기</button>
                        </div>
                    </footer>
                </section>

                <button id="dialog-show-button" class="aui-button aui-button-primary">다이얼로그 열기</button>
            </section>
        </div>
    </div>

    <script>
        AJS.toInit(function() {
            AJS.$("#dialog-show-button").click(function(e) {
                e.preventDefault();
                AJS.dialog2("#my-dialog").show();
            });

            AJS.$("#dialog-close-button").click(function(e) {
                e.preventDefault();
                AJS.dialog2("#my-dialog").hide();
            });
        });
    </script>
</body>
</html>
