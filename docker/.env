# Atlassian Docker Compose Environment Variables

# Versions
CONFLUENCE_VERSION=9.2
JIRA_VERSION=10.3
POSTGRES_VERSION=14

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1111
ATL_DB_TYPE=postgres72
# Use 'postgresql' for Confluence, 'postgres72' for Jira 10.x
CONFLUENCE_DB_TYPE=postgresql

# Resources
JVM_MIN_MEMORY=2048m
JVM_MAX_MEMORY=4096m

# System Properties
# Enable UPM upload and disable secret service encryption for plain text password usage
JVM_SUPPORT_ARGS=-Dupm.plugin.upload.enabled=true -Datlassian.secret.service.state=disabled
