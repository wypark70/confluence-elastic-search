{
	"name": "elastic-search-frontend-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"apps/*",
		"shared"
	],
	"scripts": {
		"dev": "concurrently \"pnpm --filter user-app dev\" \"pnpm --filter admin-app dev\" \"pnpm --filter demo-app dev\"",
		"dev:user": "pnpm --filter user-app dev",
		"dev:admin": "pnpm --filter admin-app dev",
		"dev:demo": "pnpm --filter demo-app dev",
		"build": "pnpm --filter shared build && pnpm -r --parallel --filter './apps/*' build",
		"build:shared": "pnpm --filter shared build",
		"build:user": "pnpm --filter shared build && pnpm --filter user-app build",
		"build:admin": "pnpm --filter shared build && pnpm --filter admin-app build",
		"build:demo": "pnpm --filter shared build && pnpm --filter demo-app build",
		"preview": "concurrently \"pnpm --filter user-app preview\" \"pnpm --filter admin-app preview\" \"pnpm --filter demo-app preview\"",
		"clean": "pnpm --filter \"*\" clean",
		"lint": "pnpm --filter \"*\" lint",
		"test": "pnpm --filter \"*\" test",
		"format": "prettier --write .",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.7.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.17",
		"@types/node": "^20.11.17",
		"@vitest/browser": "^4.0.16",
		"@vitest/browser-playwright": "^4.0.16",
		"autoprefixer": "^10.4.23",
		"concurrently": "^8.2.2",
		"flowbite": "^4.0.1",
		"flowbite-svelte": "^1.31.0",
		"flowbite-svelte-icons": "^3.1.0",
		"mdsvex": "^0.12.3",
		"postcss": "^8.5.6",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"rimraf": "^6.1.2",
		"svelte": "^5.45.6",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.6",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^4.0.16",
		"vitest-browser-svelte": "^2.0.1"
	},
	"dependencies": {
		"@elastic-search/shared": "workspace:*"
	}
}
