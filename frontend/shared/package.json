{
	"name": "@elastic-search/shared",
	"version": "1.0.0",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./components/*": "./src/components/*",
		"./types/*": "./src/types/*",
		"./utils/*": "./src/utils/*",
		"./api/*": "./src/api/*",
		"./stores/*": "./src/stores/*",
		"./i18n/*": "./src/lib/i18n/*"
	},
 "scripts": {
		"generate:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/i18n",
		"build": "pnpm generate:i18n && tsc",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"lucide-svelte": "^0.562.0"
	},

	"peerDependencies": {
		"svelte": "^5.45.6"
	},
	"devDependencies": {}
}